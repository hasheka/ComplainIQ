# OPTIONAL reference list of settings. The app runs without any of them (start.bat sets what it needs).
# The app does NOT read this file by itself: to change a setting on Windows, add a line such as
#     set MAX_UPLOAD_MB=100
# to start.bat before the 'uvicorn' line. (Linux/macOS: export MAX_UPLOAD_MB=100)

# Default is a SQLite file at storage/complainiq.db - leave this unset for local use.
# To use PostgreSQL instead (also install psycopg, see requirements.txt):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Where uploaded and cleaned files (and the SQLite database) are stored.
STORAGE_DIR=./storage

# true when served over HTTPS (a real website). start.bat sets false for http://127.0.0.1.
COOKIE_SECURE=false

SESSION_DAYS=7
MAX_UPLOAD_MB=500
MAX_ROWS=2000000
MAX_DATASETS_PER_USER=20
STALE_UPLOAD_HOURS=6
ALLOWED_ORIGINS=

# Optional: SHA-256 of the model files you trust (pickle files can run code when loaded).
MODEL_SHA256=
VECTORIZER_SHA256=
APP_NAME=ComplainIQ
